extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-33')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расход воздуха через клапан

					form.calculator-form.custom-form(data-calc="14200")
						.calculator-form__head
							.semi-24 Начальные данные
						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label Температура воздуха
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="airTemp" data-var="airTemp" data-cat="temp" inputmode="decimal" value="20")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airTemp_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airTemp_u" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airTemp_u" value="2")
															span.form-radio-name K
								.form-item-group
									.form-label Давление на входе
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="airPrimPress" data-var="airPrimPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPrimPress_u" value="11")
															span.form-radio-name mmHgG
								.form-item-group
									.form-label Давление на выходе
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="airSecondPress" data-var="airSecondPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airSecondPress_u" value="11")
															span.form-radio-name mmHgG
								.form-item-group
									.form-label Пропускная способность клапана (Kv/Cv)
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="cvValue" data-var="cvValue" data-cat="cv" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") Kv
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="cvValue_u" value="0" checked)
															span.form-radio-name Kv
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="cvValue_u" value="1")
															span.form-radio-name Cv(US)
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="cvValue_u" value="2")
															span.form-radio-name Cv(UK)
						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить
						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								.calculator-result-row.form-item-group
									.form-label
										span Расход воздуха (приведённый, Nм³)
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_airFlowRateN" data-out="airFlowRateN" data-cat="volFlow" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m³/min
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_airFlowRateN_u" value="0" checked)
															span.form-radio-name m³/min
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_airFlowRateN_u" value="1")
															span.form-radio-name m³/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_airFlowRateN_u" value="2")
															span.form-radio-name L/min
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_airFlowRateN_u" value="3")
															span.form-radio-name ft³/min
	-var title = "Расход воздуха через клапан";
