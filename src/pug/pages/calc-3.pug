extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				//LEFT SIDEBAR
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор

					include ../blocks/_acc-menu
					+calcMenu('calc-3')

				//RIGHT COLUMN
				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Потеря давления пара через трубопровод

					form.calculator-form.custom-form(data-calc="11140")
						//FORM HEADER
						.calculator-form__head
							.semi-24 Начальные данные

							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											li.dropdown__list-item
												label.form-radio-label
													input(type="radio" name="measure" value="0")
													span.form-radio-name SI
											li.dropdown__list-item
												label.form-radio-label
													input(type="radio" name="measure" value="1" checked)
													span.form-radio-name SI(bar)
											li.dropdown__list-item
												label.form-radio-label
													input(type="radio" name="measure" value="2")
													span.form-radio-name Imperial
											li.dropdown__list-item
												label.form-radio-label
													input(type="radio" name="measure" value="3")
													span.form-radio-name MKS

						//FORM BODY
						.calculator-form__body
							.calculator-fieldset.form-two-cols
								//Класс трубопровода
								.form-item-group
									.form-label
										span Класс трубопровода
									.dropdown(data-var="pipeGrade" data-type="grade")
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") DIN 2448
										.dropdown__list
											ul
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="0")
														span.form-radio-name JIS-SGP
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="1")
														span.form-radio-name JIS-STPG Sch40
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="2")
														span.form-radio-name JIS-STPG Sch60
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="3")
														span.form-radio-name JIS-STPG Sch80
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="4")
														span.form-radio-name ANSI Sch40
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="5")
														span.form-radio-name ANSI Sch80
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="6")
														span.form-radio-name ANSI Sch160
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="truboprovod_class" value="7" checked)
														span.form-radio-name DIN 2448

								//Номинальный диаметр трубы
								.form-item-group
									.form-label
										span Номинальный диаметр трубы
									.dropdown(data-var="pipeSize" data-type="size")
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") 25A
										.dropdown__list
											ul
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="0")
														span.form-radio-name 10A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="1")
														span.form-radio-name 15A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="2")
														span.form-radio-name 20A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="3" checked)
														span.form-radio-name 25A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="4")
														span.form-radio-name 32A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="5")
														span.form-radio-name 40A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="6")
														span.form-radio-name 50A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="7")
														span.form-radio-name 65A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="8")
														span.form-radio-name 80A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="9")
														span.form-radio-name 100A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="10")
														span.form-radio-name 125A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="11")
														span.form-radio-name 150A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="12")
														span.form-radio-name 200A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="13")
														span.form-radio-name 250A
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="nominal_diametr" value="14")
														span.form-radio-name 300A

								//Давление пара
								.form-item-group
									.form-label Давление пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(
											type="text"
											name="current_davlenie_para"
											data-var="stmPress"
											data-cat="pressureAbs"
											inputmode="decimal"
											value="0"
										)

										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="davlenie_para" value="11")
															span.form-radio-name mmHgG

								//Температура пара
								.form-item-group
									.form-label.has-tooltip
										span Температура пара
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура пара:<br>Для перегретого пара введите температуру выше, чем температура насыщения
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(
											type="text"
											name="current_temperatura_para"
											data-var="stmTemp"
											data-cat="temp"
											inputmode="decimal"
											placeholder="99.9743"
										)

										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="temperatura_para" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="temperatura_para" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="temperatura_para" value="2")
															span.form-radio-name K

								//Расход пара
								.form-item-group
									.form-label Расход пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(
											type="text"
											name="current_rashod_para"
											data-var="stmFlow"
											data-cat="massFlow"
											inputmode="decimal"
											value="0"
										)

										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="rashod_para" value="0" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="rashod_para" value="1")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="rashod_para" value="2")
															span.form-radio-name lb/h

								//Длина трубопровода
								.form-item-group
									.form-label.has-tooltip
										span Длина трубопровода
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Длина трубопровода:<br>Введите полную длину трубопровода
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(
											type="text"
											name="current_dlina_truboprovoda"
											data-var="pipeLen"
											data-cat="length"
											inputmode="decimal"
											value="0"
										)

										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="0")
															span.form-radio-name mm
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="1")
															span.form-radio-name cm
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="2" checked)
															span.form-radio-name m
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="3")
															span.form-radio-name in
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="4")
															span.form-radio-name ft
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="dlina_truboprovoda" value="5")
															span.form-radio-name yd

							//СКРЫТЫЕ ДОП ОПЦИИ
							.hide-block-wrapper
								.calculator-fieldset.is-hide-block
									.form-two-cols
										.form-item-group
											.form-label.has-tooltip
												span Клапаны с изменяемым направлением потока (вентили и т.п.) (кол-во)
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Клапаны с изменяемым направлением потока (вентили и т.п.) (кол-во):<br>Введите количество клапанов с изменением потока (вентили и пр.)
											.form-item
												input.form-inp(type="number" name="klapan_1" value="0" data-var="fit.obsFlo")

										.form-item-group
											.form-label.has-tooltip
												span Проходные клапаны (задвижки и т.п.) (кол-во)
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Проходные клапаны (задвижки и т.п.) (кол-во):<br>Введите количество проходных клапанов на трубопроводе
											.form-item
												input.form-inp(type="number" name="klapan_2" value="0" data-var="fit.thruFlo")

										.form-item-group
											.form-label.has-tooltip
												span Обратные клапаны (кол-во)
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Обратные клапаны (кол-во):<br>Введите количество обратных клапанов на трубопроводе
											.form-item
												input.form-inp(type="number" name="klapan_3" value="0" data-var="fit.check")

										.form-item-group
											.form-label.has-tooltip
												span Отводы (кол-во)
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Отводы (кол-во):<br>Введите количество отводов
											.form-item
												input.form-inp(type="number" name="klapan_4" value="0" data-var="fit.elbow")

										//Возраст трубы
										.form-item-group
											.form-label Возраст трубы влияет на поверхность, делая ее более грубой со временем.
											.form-item.form-item--measure
												input.form-inp.form-inp--measure(
													type="text"
													name="current_vozrast_truby"
													data-var="pipeRough"
													data-cat="length"
													inputmode="decimal"
													value="0.05"
												)

												.dropdown.dropdown--measure
													button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") mm
													.dropdown__list
														ul
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="0" checked)
																	span.form-radio-name mm
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="1")
																	span.form-radio-name cm
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="2")
																	span.form-radio-name m
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="3")
																	span.form-radio-name in
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="4")
																	span.form-radio-name ft
															li.dropdown__list-item
																label.form-radio-label
																	input(type="radio" name="vozrast_truby" value="5")
																	span.form-radio-name yd

								button.open-hide-btn.ml-auto.mt-20(type="button")
									i.plus-minus
									span.hide-btn-txt.medi-15 Показать дополнительные опции

						//FORM FOOTER
						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						//FORM RESULT
						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								//Скорость пара
								.calculator-result-row.form-item-group
									.form-label
										span Скорость пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_velo" data-out="stmVelo" data-cat="velocity" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m/s
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_velo_unit" value="m/s" checked)
															span.form-radio-name m/s
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_velo_unit" value="ft/s")
															span.form-radio-name ft/s
								//Потери давления
								.calculator-result-row.form-item-group
									.form-label
										span Потери давления
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_dp" data-out="pressLoss" data-cat="dPress" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") bar
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="bar" checked)
															span.form-radio-name bar
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="kPa")
															span.form-radio-name kPa
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="MPa")
															span.form-radio-name MPa
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="psi")
															span.form-radio-name psi
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="kg/cm²")
															span.form-radio-name kg/cm²
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dp_unit" value="mmHg")
															span.form-radio-name mmHg
								//Эквивалентная длина прямого участка трубы
								.calculator-result-row.form-item-group
									.form-label
										span Эквивалентная длина прямого участка трубы
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_leq" data-out="equivLen" data-cat="length" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_leq_unit" value="m" checked)
															span.form-radio-name m
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_leq_unit" value="mm")
															span.form-radio-name mm
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_leq_unit" value="ft")
															span.form-radio-name ft
					//formulas
					.formulas
						.formulas__title Формулы:
						.formulas__block
							.formulas__image
								img(src='./img/calc/calc-3.webp' width='600' height='200' loading='lazy' alt='img')

							.formulas__list
								table
									tr
										td d
										td : Внутренний диаметр трубопровода (m)
									tr
										td ms
										td : Расход пара (kg/h)
									tr
										td l
										td : Длина трубопровода (m)
									tr
										td v
										td : Скорость пара (m/s)
									tr
										td ∆p
										td : Потери давления (Pa)
									tr
										td μ
										td : Коэффициент трения
									tr
										td V
										td : Удельный объем (m³/kg)
	-var title = "Потеря давления пара через трубопровод";
