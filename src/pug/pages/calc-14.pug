extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-14')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Образование выпара при выпуске конденсата

					form.calculator-form.custom-form(data-calc="12310")
						.calculator-form__head
							.semi-24 Начальные данные
							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											- var measUnits = ['SI','SI(bar)','Imperial','MKS'];
											- for (var i = 0; i < measUnits.length; i++)
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="measure" value=i checked=(i===1))
														span.form-radio-name= measUnits[i]

						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label.has-tooltip
										span Давление конденсата
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Давление конденсата :<br/>Введите давление на входе в конденсатоотводчик
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_davlenie_kondensata" data-var="condPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													- var pUnits = ['kPa abs','MPa abs','psi abs','bar abs','kg/cm² abs','mmHg abs','kPaG','MPaG','psig','barG','kg/cm²G','mmHgG'];
													- for (var i = 0; i < pUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="davlenie_kondensata" value=i checked=(i===9))
																span.form-radio-name= pUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Расход конденсата
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Расход конденсата :<br/>Введите расход конденсата в теплообменнике
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_rashod_kondensata" data-var="condFlow" data-cat="massFlow" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													- var fUnits = ['kg/h','t(metric)/h','lb/h'];
													- for (var i = 0; i < fUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="rashod_kondensata" value=i checked=(i===0))
																span.form-radio-name= fUnits[i]

								.form-item-group
									.form-label Противодавление в конденсатной линии
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_protivodavlenie" data-var="recoveryPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													- for (var i = 0; i < pUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="protivodavlenie" value=i checked=(i===9))
																span.form-radio-name= pUnits[i]

						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								//Расход пара вторичного вскипания
								.calculator-result-row.form-item-group
									.form-label
										span Расход пара вторичного вскипания
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_flash" data-out="flashFlow" data-cat="massFlow" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_flash_unit" value="kg/h" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_flash_unit" value="t(metric)/h")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_flash_unit" value="lb/h")
															span.form-radio-name lb/h
								//Доля вторичного пара (%)
								.calculator-result-row.form-item-group
									.form-label
										span Доля вторичного пара (%)
									.form-item
										input.form-inp(type="text" name="res_ratio" data-out="flashRatio" readonly)
					.formulas
						.formulas__title Формулы:
						.formulas__block
							.formulas__image
								img(src='./img/calc/calc-14.webp' width='600' height='200' loading='lazy' alt='img')
							.formulas__list
								table
									tr
										td mc
										td : Расход конденсата (kg/h)
									tr
										td mfｓ
										td : Расход пара вторичного вскипания (kg/h)
									tr
										td Rfs
										td : Процентное отношение пара вторичного вскипания (%)
									tr
										td hc
										td : Удельная энтальпия конденсата (kJ/kg)
									tr
										td hfc
										td : Удельная энтальпия воды в состоянии насыщения (kj/kg)
									tr
										td hfg
										td : Скрытая теплота парообразования пара вторичного вскипания (kJ/kg)
	-var title = "Образование выпара при выпуске конденсата";
