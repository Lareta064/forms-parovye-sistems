extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-13')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расход конденсата за счёт теплопотерь с поверхности трубы (только для насыщенного пара)

					form.calculator-form.custom-form
						.calculator-form__head
							.semi-24 Начальные данные
							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											- var measUnits = ['SI','SI(bar)','Imperial','MKS'];
											- for (var i = 0; i < measUnits.length; i++)
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="measure" value=i checked=(i===1))
														span.form-radio-name= measUnits[i]

						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label
										span Класс трубопровода
									.dropdown
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") DIN 2448
										.dropdown__list
											ul
												- var pipeClasses = ['JIS-SGP','JIS-STPG Sch40','JIS-STPG Sch60','JIS-STPG Sch80','ANSI Sch40','ANSI Sch80','ANSI Sch160','DIN 2448'];
												- for (var i = 0; i < pipeClasses.length; i++)
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="truboprovod_class" value=i checked=(i===7))
															span.form-radio-name= pipeClasses[i]

								.form-item-group
									.form-label
										span Диаметр трубопровода
									.dropdown
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") DN6
										.dropdown__list
											ul
												- var dnList = ['DN6','DN8','DN10','DN15','DN20','DN25','DN32','DN40','DN50','DN65','DN80','DN100','DN125','DN150','DN200','DN250','DN300','DN350','DN400','DN450','DN500'];
												- for (var i = 0; i < dnList.length; i++)
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="diametr_truboprovoda" value=i checked=(i===0))
															span.form-radio-name= dnList[i]

								.form-item-group
									.form-label.has-tooltip
										span Изоляция
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Изоляция :<br/>Значения теплопроводности в соответствии со стандартами JIS
									.dropdown
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") Минеральная вата Rockwool
										.dropdown__list
											ul
												- var izolList = ['Минеральная вата Rockwool','Стекловата','Силикат кальция','Перлит'];
												- for (var i = 0; i < izolList.length; i++)
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="izolyatsiya" value=i checked=(i===0))
															span.form-radio-name= izolList[i]

								.form-item-group
									.form-label Давление пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_davlenie_para" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													- var pUnits = ['kPa abs','MPa abs','psi abs','bar abs','kg/cm² abs','mmHg abs','kPaG','MPaG','psig','barG','kg/cm²G','mmHgG'];
													- for (var i = 0; i < pUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="davlenie_para" value=i checked=(i===9))
																span.form-radio-name= pUnits[i]

								.form-item-group
									.form-label Скорость ветра
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_skorost_vetra" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m/s
											.dropdown__list
												ul
													- var vUnits = ['m/s','km/h','ft/s','mile/h'];
													- for (var i = 0; i < vUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="skorost_vetra" value=i checked=(i===0))
																span.form-radio-name= vUnits[i]

								.form-item-group
									.form-label Толщина теплоизоляционного покрытия
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_tolshchina_izol" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") mm
											.dropdown__list
												ul
													- var lUnits = ['mm','cm','m','in','ft','yd'];
													- for (var i = 0; i < lUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="tolshchina_izol" value=i checked=(i===0))
																span.form-radio-name= lUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Длина трубопровода
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Длина трубопровода :<br/>Введите полную длину трубопровода
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_dlina" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m
											.dropdown__list
												ul
													- for (var i = 0; i < lUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="dlina" value=i checked=(i===2))
																span.form-radio-name= lUnits[i]

								.form-item-group
									.form-label Температура окружающей среды
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_temp_okr" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- var tUnits = ['°C','°F','K'];
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="temp_okr" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16 Пожалуйста введите данные в поля
					.formulas
						.formulas__title Формулы:
						.formulas__block
							.formulas__image
								img(src='./img/calc/calc-13.webp' width='600' height='200' loading='lazy' alt='img')
							.formulas__list
								.formulas__item
									p mc: Расход конденсата (kg/h)
								.formulas__item
									p L: Длина трубопровода
								.formulas__item
									p T1: Температура окружающей среды
								.formulas__item
									p T2: Температура пара (насыщенного)
								.formulas__item
									p k: Коэффициент теплопередачи

	-var title = "Расход конденсата за счёт теплопотерь";
