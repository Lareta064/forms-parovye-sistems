extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-40')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Улучшение сухости пара (редуцирование + сепаратор)

					form.calculator-form.custom-form(data-calc="11450")
						.calculator-form__head
							.semi-24 Начальные данные
						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label Давление на входе
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="stmPrimPress" data-var="stmPrimPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmPrimPress_u" value="11")
															span.form-radio-name mmHgG
								.form-item-group
									.form-label Давление на выходе
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="stmSecondPress" data-var="stmSecondPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmSecondPress_u" value="11")
															span.form-radio-name mmHgG
								.form-item-group
									.form-label Расход пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="stmFlow" data-var="stmFlow" data-cat="massFlow" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmFlow_u" value="0" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmFlow_u" value="1")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="stmFlow_u" value="2")
															span.form-radio-name lb/h
								.form-item-group
									.form-label Эффективность сепаратора (%)
									.form-item
										input.form-inp(type="number" name="separateEff" data-var="separateEff" value="98")
								.form-item-group
									.form-label Отделённый конденсат
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="sepaCond" data-var="sepaCond" data-cat="massFlow" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="sepaCond_u" value="0" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="sepaCond_u" value="1")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="sepaCond_u" value="2")
															span.form-radio-name lb/h
						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить
						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								.calculator-result-row.form-item-group
									.form-label
										span Оценочная сухость на входе (%)
									.form-item
										input.form-inp(type="text" name="r_estPrimStmDry" data-out="estPrimStmDry" readonly)
								.calculator-result-row.form-item-group
									.form-label
										span Сухость пара на выходе (%)
									.form-item
										input.form-inp(type="text" name="r_secDryness" data-out="secDryness" readonly)
								.calculator-result-row.form-item-group
									.form-label
										span Степень перегрева
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_degreeOfSuper" data-out="degreeOfSuper" data-cat="tempDiff" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_degreeOfSuper_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_degreeOfSuper_u" value="1")
															span.form-radio-name K
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_degreeOfSuper_u" value="2")
															span.form-radio-name °F
								.calculator-result-row.form-item-group
									.form-label
										span Температура насыщения
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_satTemp" data-out="satTemp" data-cat="temp" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_satTemp_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_satTemp_u" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_satTemp_u" value="2")
															span.form-radio-name K
	-var title = "Улучшение сухости пара (редуцирование + сепаратор)";
