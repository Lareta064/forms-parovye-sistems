extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-12')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расход конденсата при нагреве воздуха

					form.calculator-form.custom-form(data-calc="11340")
						.calculator-form__head
							.semi-24 Начальные данные
							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											- var measUnits = ['SI','SI(bar)','Imperial','MKS'];
											- for (var i = 0; i < measUnits.length; i++)
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="measure" value=i checked=(i===1))
														span.form-radio-name= measUnits[i]

						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label Давление пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_davlenie_para" data-var="stmPress" data-cat="pressureAbs" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													- var pUnits = ['kPa abs','MPa abs','psi abs','bar abs','kg/cm² abs','mmHg abs','kPaG','MPaG','psig','barG','kg/cm²G','mmHgG'];
													- for (var i = 0; i < pUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="davlenie_para" value=i checked=(i===9))
																span.form-radio-name= pUnits[i]

								.form-item-group
									.form-label Расход воздуха (текущий)
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_rashod_vozduha" data-var="airFlow" data-cat="volFlow" inputmode="decimal" placeholder="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m³/min
											.dropdown__list
												ul
													- var qUnits = ['m³/min','m³/h','L/min','ft³/min'];
													- for (var i = 0; i < qUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="rashod_vozduha" value=i checked=(i===0))
																span.form-radio-name= qUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Температура воздуха на входе
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура воздуха на входе :<br/>Введите температуру воздуха перед нагревом
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_t_in" data-var="airInTemp" data-cat="temp" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- var tUnits = ['°C','°F','K'];
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="t_in_unit" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Температура воздуха на выходе
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура воздуха на выходе :<br/>Введите заданную температуру воздуха
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_t_out" data-var="airOutTemp" data-cat="temp" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="t_out_unit" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

							.hide-block-wrapper
								.calculator-fieldset.is-hide-block
									.form-two-cols
										.form-item-group
											.form-label.has-tooltip
												span Температура пара
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Температура пара :<br/>Для перегретого пара введите темпетаруру выше, чем температура насыщения
											.form-item.form-item--measure
												input.form-inp.form-inp--measure(type="text" name="current_temperatura_para" data-var="stmTemp" data-cat="temp" inputmode="decimal" placeholder="99.9743")
												.dropdown.dropdown--measure
													button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
													.dropdown__list
														ul
															- for (var i = 0; i < tUnits.length; i++)
																li.dropdown__list-item
																	label.form-radio-label
																		input(type="radio" name="temperatura_para" value=i checked=(i===0))
																		span.form-radio-name= tUnits[i]

								button.open-hide-btn.ml-auto.mt-20(type="button")
									i.plus-minus
									span.hide-btn-txt.medi-15 Показать дополнительные опции

						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								//Расход конденсата
								.calculator-result-row.form-item-group
									.form-label
										span Расход конденсата
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_cond" data-out="condLoad" data-cat="massFlow" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_cond_unit" value="kg/h" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_cond_unit" value="t(metric)/h")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_cond_unit" value="lb/h")
															span.form-radio-name lb/h
					.formulas
						.formulas__title Формулы:
						.formulas__block
							.formulas__image
								img(src='./img/calc/calc-12.webp' width='600' height='200' loading='lazy' alt='img')
							.formulas__list
								table
									tr
										td Qa
										td : Расход воздуха (текущий) (m³/min)
									tr
										td T1
										td : Температура воздуха на входе (°C)
									tr
										td T2
										td : Температура воздуха на выходе (°C)
									tr
										td mc
										td : Расход конденсата (kg/h)
									tr
										td ∆H
										td : Скрытая теплота парообразования (kJ/kg)
									tr
										td ca
										td : Удельная теплоемкость воздуха (kJ/kg K)
									tr
										td γa
										td : Удельный вес воздуха (kg/m³)
	-var title = "Расход конденсата при нагреве воздуха";
