extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-16')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Таблица свойств насыщенного пара по температуре

					form.calculator-form.custom-form(data-calc="11520")
						.calculator-form__head
							.semi-24 Начальные данные
							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											- var measUnits = ['SI','SI(bar)','Imperial','MKS'];
											- for (var i = 0; i < measUnits.length; i++)
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="measure" value=i checked=(i===1))
														span.form-radio-name= measUnits[i]

						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label.has-tooltip
										span Температура пара
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура пара :<br/>Для перегретого пара введите темпетаруру выше, чем температура насыщения
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_temperatura_para" data-var="stmTemp" data-cat="temp" inputmode="decimal" placeholder="99.9743")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- var tUnits = ['°C','°F','K'];
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="temperatura_para" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								//Давление пара
								.calculator-result-row.form-item-group
									.form-label
										span Давление пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_ps" data-out="stmPress" data-cat="pressureAbs" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="barG" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="bar abs")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="kPa abs")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="MPa abs")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="psi abs")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_ps_unit" value="kg/cm²G")
															span.form-radio-name kg/cm²G
								//Скрытая теплота парообразования
								.calculator-result-row.form-item-group
									.form-label
										span Скрытая теплота парообразования
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_dh" data-out="latentHeat" data-cat="enthalpy" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kJ/kg
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dh_unit" value="kJ/kg" checked)
															span.form-radio-name kJ/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dh_unit" value="kcal/kg")
															span.form-radio-name kcal/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_dh_unit" value="BTU/lb")
															span.form-radio-name BTU/lb
								//Удельная энтальпия пара
								.calculator-result-row.form-item-group
									.form-label
										span Удельная энтальпия пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_hg" data-out="satVapEnth" data-cat="enthalpy" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kJ/kg
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hg_unit" value="kJ/kg" checked)
															span.form-radio-name kJ/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hg_unit" value="kcal/kg")
															span.form-radio-name kcal/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hg_unit" value="BTU/lb")
															span.form-radio-name BTU/lb
								//Удельная энтальпия воды
								.calculator-result-row.form-item-group
									.form-label
										span Удельная энтальпия воды
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_hf" data-out="satWtrEnth" data-cat="enthalpy" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kJ/kg
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hf_unit" value="kJ/kg" checked)
															span.form-radio-name kJ/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hf_unit" value="kcal/kg")
															span.form-radio-name kcal/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_hf_unit" value="BTU/lb")
															span.form-radio-name BTU/lb
								//Удельный объём пара
								.calculator-result-row.form-item-group
									.form-label
										span Удельный объём пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_vg" data-out="satVapVol" data-cat="specVol" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m³/kg
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vg_unit" value="m³/kg" checked)
															span.form-radio-name m³/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vg_unit" value="L/kg")
															span.form-radio-name L/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vg_unit" value="ft³/lb")
															span.form-radio-name ft³/lb
								//Удельный объём воды
								.calculator-result-row.form-item-group
									.form-label
										span Удельный объём воды
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="res_vf" data-out="satWtrVol" data-cat="specVol" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m³/kg
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vf_unit" value="m³/kg" checked)
															span.form-radio-name m³/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vf_unit" value="L/kg")
															span.form-radio-name L/kg
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="res_vf_unit" value="ft³/lb")
															span.form-radio-name ft³/lb
	-var title = "Таблица свойств насыщенного пара по температуре";
