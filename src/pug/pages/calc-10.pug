extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-10')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расход конденсата при нагреве жидкости (непрерывном)

					form.calculator-form.custom-form
						.calculator-form__head
							.semi-24 Начальные данные
							.calculator-form__measure
								p.medi-16 Единицы измерения
								.dropdown.dropdown--abs
									button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") SI(bar)
									.dropdown__list
										ul
											- var measUnits = ['SI','SI(bar)','Imperial','MKS'];
											- for (var i = 0; i < measUnits.length; i++)
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="measure" value=i checked=(i===1))
														span.form-radio-name= measUnits[i]

						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label
										span Тип среды
									.dropdown
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") Вода
										.dropdown__list
											ul
												- var sredaList = ['Вода','Морская вода','Керосин','Этанол','Глицерин'];
												- for (var i = 0; i < sredaList.length; i++)
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="tip_sredy" value=i checked=(i===0))
															span.form-radio-name= sredaList[i]

								.form-item-group
									.form-label Плотность
									.form-item
										input.form-inp(type="text" name="plotnost" inputmode="decimal" value="1")

								.form-item-group
									.form-label Теплосодержание
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_teplo" inputmode="decimal" value="4.19")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kJ/kg K
											.dropdown__list
												ul
													- var teploUnits = ['kJ/kg K','kcal/kg·°C','BTU/lb °F'];
													- for (var i = 0; i < teploUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="teplo_unit" value=i checked=(i===0))
																span.form-radio-name= teploUnits[i]

								.form-item-group
									.form-label Расход жидкости
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_rashod_zhidk" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m³/h
											.dropdown__list
												ul
													- var qUnits = ['m³/h','l/h','gal/h','GPM'];
													- for (var i = 0; i < qUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="rashod_zhidk" value=i checked=(i===0))
																span.form-radio-name= qUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Температура жидкости на входе
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура жидкости на входе :<br/>Введите температуру воды перед нагревом
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_t_in" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- var tUnits = ['°C','°F','K'];
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="t_in_unit" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

								.form-item-group
									.form-label.has-tooltip
										span Температура жидкости на выходе
										.tooltip-wrapper
											span.tooltip-icon i
											.tooltip-text
												p Температура жидкости на выходе :<br/>Введите заданную температуру воды
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_t_out" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													- for (var i = 0; i < tUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="t_out_unit" value=i checked=(i===0))
																span.form-radio-name= tUnits[i]

								.form-item-group
									.form-label Давление пара
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="current_davlenie_para" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													- var pUnits = ['kPa abs','MPa abs','psi abs','bar abs','kg/cm² abs','mmHg abs','kPaG','MPaG','psig','barG','kg/cm²G','mmHgG'];
													- for (var i = 0; i < pUnits.length; i++)
														li.dropdown__list-item
															label.form-radio-label
																input(type="radio" name="davlenie_para" value=i checked=(i===9))
																span.form-radio-name= pUnits[i]

							.hide-block-wrapper
								.calculator-fieldset.is-hide-block
									.form-two-cols
										.form-item-group
											.form-label.has-tooltip
												span Температура пара
												.tooltip-wrapper
													span.tooltip-icon i
													.tooltip-text
														p Температура пара :<br/>Для перегретого пара введите темпетаруру выше, чем температура насыщения
											.form-item.form-item--measure
												input.form-inp.form-inp--measure(type="text" name="current_temperatura_para" inputmode="decimal" value="(99.9743)")
												.dropdown.dropdown--measure
													button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
													.dropdown__list
														ul
															- for (var i = 0; i < tUnits.length; i++)
																li.dropdown__list-item
																	label.form-radio-label
																		input(type="radio" name="temperatura_para" value=i checked=(i===0))
																		span.form-radio-name= tUnits[i]

								button.open-hide-btn.ml-auto.mt-20(type="button")
									i.plus-minus
									span.hide-btn-txt.medi-15 Показать дополнительные опции

						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить

						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16 Пожалуйста введите данные в поля
					.formulas
						.formulas__title Формулы:
						.formulas__block
							.formulas__image
								img(src='./img/calc/calc-10.webp' width='600' height='200' loading='lazy' alt='img')
							.formulas__list
								.formulas__item
									p mc: Расход конденсата (kg/h)
								.formulas__item
									p Q: Расход жидкости
								.formulas__item
									p c: Теплосодержание
								.formulas__item
									p T1, T2: Температура жидкости (вход / выход)
								.formulas__item
									p ΔH: Скрытая теплота парообразования

	-var title = "Расход конденсата при нагреве жидкости (непрерывном)";
