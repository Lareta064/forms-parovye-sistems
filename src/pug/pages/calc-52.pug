extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-52')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расход конденсата при осушении сжатого воздуха

					form.calculator-form.custom-form(data-calc="14500")
						.calculator-form__head
							.semi-24 Начальные данные
						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label Давление сжатого воздуха
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="airPress" data-var="airPress" data-cat="pressureAbs" inputmode="decimal" value="7")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") barG
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="0")
															span.form-radio-name kPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="1")
															span.form-radio-name MPa abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="2")
															span.form-radio-name psi abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="3")
															span.form-radio-name bar abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="4")
															span.form-radio-name kg/cm² abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="5")
															span.form-radio-name mmHg abs
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="6")
															span.form-radio-name kPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="7")
															span.form-radio-name MPaG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="8")
															span.form-radio-name psig
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="9" checked)
															span.form-radio-name barG
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="10")
															span.form-radio-name kg/cm²G
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="airPress_u" value="11")
															span.form-radio-name mmHgG
								.form-item-group
									.form-label Относительная влажность (%)
									.form-item
										input.form-inp(type="number" name="relative" data-var="relative" value="65")
								.form-item-group
									.form-label Температура окружающей среды
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="ambTemp" data-var="ambTemp" data-cat="temp" inputmode="decimal" value="30")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="ambTemp_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="ambTemp_u" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="ambTemp_u" value="2")
															span.form-radio-name K
								.form-item-group
									.form-label Температура охлаждения
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="coolTemp" data-var="coolTemp" data-cat="temp" inputmode="decimal" value="10")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="coolTemp_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="coolTemp_u" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="coolTemp_u" value="2")
															span.form-radio-name K
								.form-item-group
									.form-label Расход воздуха, привед. к норм. условиям (Nm³/min)
									.form-item
										input.form-inp(type="number" name="airFlowN" data-var="airFlowN" value="10")
						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить
						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								.calculator-result-row.form-item-group
									.form-label
										span Расход конденсата
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_condFlowLoad" data-out="condFlowLoad" data-cat="massFlow" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condFlowLoad_u" value="0" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condFlowLoad_u" value="1")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condFlowLoad_u" value="2")
															span.form-radio-name lb/h
								.calculator-result-row.form-item-group
									.form-label
										span Начальное влагосодержание (г/кг)
									.form-item
										input.form-inp(type="text" name="r_initMoistCont" data-out="initMoistCont" readonly)
								.calculator-result-row.form-item-group
									.form-label
										span Точка росы
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_dewPoint" data-out="dewPoint" data-cat="temp" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") °C
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_dewPoint_u" value="0" checked)
															span.form-radio-name °C
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_dewPoint_u" value="1")
															span.form-radio-name °F
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_dewPoint_u" value="2")
															span.form-radio-name K
	-var title = "Расход конденсата при осушении сжатого воздуха";
