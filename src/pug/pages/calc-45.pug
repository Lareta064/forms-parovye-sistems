extends ../layouts/layout-white.pug

block content
	main.calc-main.calculator-single
		.container-1440
			.grid-column-left
				.grid-column-sidebar
					.sidebar-title.txt-center
						.font-20 Инженерный калькулятор
					include ../blocks/_acc-menu
					+calcMenu('calc-45')

				.grid-column-main.grid-column-calc
					.grid-column-head
						p.breadcrumb Тут компонент breadcrumbs
						h1.h-30 Расчёт диаметра трубы между оборудованием и конденсатоотводчиком

					form.calculator-form.custom-form(data-calc="12210")
						.calculator-form__head
							.semi-24 Начальные данные
						.calculator-form__body
							.calculator-fieldset.form-two-cols
								.form-item-group
									.form-label
										span Класс трубопровода
									.dropdown(data-var="pipeGrade" data-type="grade")
										button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") DIN 2448
										.dropdown__list
											ul
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="0")
														span.form-radio-name JIS-SGP
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="1")
														span.form-radio-name JIS-STPG Sch40
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="2")
														span.form-radio-name JIS-STPG Sch60
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="3")
														span.form-radio-name JIS-STPG Sch80
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="4")
														span.form-radio-name ANSI Sch40
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="5")
														span.form-radio-name ANSI Sch80
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="6")
														span.form-radio-name ANSI Sch160
												li.dropdown__list-item
													label.form-radio-label
														input(type="radio" name="pipeGrade_o" value="7" checked)
														span.form-radio-name DIN 2448
								.form-item-group
									.form-label Расход конденсата
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="condFlow" data-var="condFlow" data-cat="massFlow" inputmode="decimal" value="0")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") kg/h
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="condFlow_u" value="0" checked)
															span.form-radio-name kg/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="condFlow_u" value="1")
															span.form-radio-name t(metric)/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="condFlow_u" value="2")
															span.form-radio-name lb/h
								.form-item-group
									.form-label Максимально допустимая скорость
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="upperVelo" data-var="upperVelo" data-cat="velocity" inputmode="decimal" value="1.5")
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m/s
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="upperVelo_u" value="0" checked)
															span.form-radio-name m/s
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="upperVelo_u" value="1")
															span.form-radio-name km/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="upperVelo_u" value="2")
															span.form-radio-name ft/s
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="upperVelo_u" value="3")
															span.form-radio-name mile/h
						.calculator-form__footer.flex-column.flex-center
							button.form-button(type="submit") Рассчитать
							button.w-auto.btn-clear-form(type="reset") Очистить
						.calculator-form__result
							p.semi-24 Результат:
							.calculator-result-block
								p.medi-16(data-result-note)
								.calculator-result-row.form-item-group
									.form-label
										span Диаметр трубопровода
									.form-item
										input.form-inp(type="text" name="r_pipeSize" data-out="pipeSize" readonly)
								.calculator-result-row.form-item-group
									.form-label
										span Внутренний диаметр трубопровода
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_pipeInDiam" data-out="pipeInDiam" data-cat="length" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") mm
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="0" checked)
															span.form-radio-name mm
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="1")
															span.form-radio-name cm
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="2")
															span.form-radio-name m
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="3")
															span.form-radio-name in
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="4")
															span.form-radio-name ft
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_pipeInDiam_u" value="5")
															span.form-radio-name yd
								.calculator-result-row.form-item-group
									.form-label
										span Скорость конденсата
									.form-item.form-item--measure
										input.form-inp.form-inp--measure(type="text" name="r_condVelo" data-out="condVelo" data-cat="velocity" inputmode="decimal" readonly)
										.dropdown.dropdown--measure
											button.dropdown__button(type="button" aria-haspopup="listbox" aria-expanded="false") m/s
											.dropdown__list
												ul
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condVelo_u" value="0" checked)
															span.form-radio-name m/s
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condVelo_u" value="1")
															span.form-radio-name km/h
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condVelo_u" value="2")
															span.form-radio-name ft/s
													li.dropdown__list-item
														label.form-radio-label
															input(type="radio" name="r_condVelo_u" value="3")
															span.form-radio-name mile/h
	-var title = "Расчёт диаметра трубы между оборудованием и конденсатоотводчиком";
